{
  "manifest_version": 3,
  "name": "YCUT Blue User Scanner",
  "version": "1.2.3",
  "description": "精準掃描 YCUT 社區頁面的藍色可點小人並可視覺化標示。",
  "action": {
    "default_title": "YCUT Blue User Scanner",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://is.ycut.com.tw/magent/*",
    "https://ycut-license-api.sir8713642.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://is.ycut.com.tw/magent/Community.aspx*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
